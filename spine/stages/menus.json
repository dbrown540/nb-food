       ],
       "contentHash": "sha256:152188ddc708a29e2c3def3d373d2bc266af19b95ccbfa02822cb08a990be483",
       "outputs": {
        "format": "pins",
        "path": "data/tag_pins.jsonl"
       },
       "pins": "data/tag_pins.jsonl",
       "gap": {
        "text": "No labelled sample has been measured against this battery; a spot check is not a measurement.",
        "reviewBy": "2026-12-31"
       }
      },
      {
       "tier": "T1",
       "kind": "code",
       "label": "readings disagree, or a present answer quotes nothing in the item: unknown",
       "path": "scripts/tag_items.py",
       "symbol": "route_attribute"
      }
     ]
    },
    {
