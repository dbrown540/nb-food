     "call": "scripts/tag_items.py:decide_case",
     "input": "spine/cases/item-attributes/butternut-not-nut.json",
     "expect": {
      "tagged": true,
      "answers": {
       "nuts": "no"
      }
     }
    },
    {
     "given": "two readings quote the item: at the agreement bar",
     "call": "scripts/tag_items.py:route_case",
