  {
   "id": "item-attributes",
   "statement": "An item has an attribute only when its own words say so, lacks it only when its own words rule it out, and is otherwise unknown; the absence of a word is never evidence of absence.",
   "grain": "item",
   "tier": "T2",
   "implementers": [
    {
     "role": "decides",
     "kind": "cascade",
     "route": {
      "path": "scripts/tag_items.py",
