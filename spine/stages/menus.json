        "path": "spine/bindings.json",
        "key": "item-attributes"
       }
      ]
     },
     "paths": [
      {
       "tier": "T2",
       "kind": "battery",
       "label": "repeated readings agree, and a present answer quotes the item",
       "path": "spine/battery/item-attributes.md",
       "hashes": [
        "spine/battery/item-attributes.md",
