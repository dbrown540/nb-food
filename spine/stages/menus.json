{
 "stage": "menus",
 "story": "Each place's menu or store product list is read from the place's own published source into items with their listed words and prices. A list older than the kept age is flagged, and once past due it stops the build until it is refreshed or an extension is ruled. Every item is then read for a fixed vocabulary of food attributes, and each attribute is answered present, absent or unknown from the item's own words.",
 "principles": [
  {
   "id": "menu-extraction",
   "statement": "A menu item is recorded only as its place's source lists it, with the source's own words and price, and nothing is inferred or completed.",
   "grain": "menu",
   "tier": "T3",
   "whyNotLower": "Menus arrive as web pages, PDFs and photographs with no shared structure; no parser or closed answer set covers them. A store's structured product feed is parsed by code instead and records that basis.",
   "implementers": [
    {
     "role": "decides",
     "kind": "prompt",
     "path": "spine/prompts/menu-extract.md",
     "contentHash": "sha256:cad26f6dfcb65d52808ab71525a11ea198f6b68f4c11593bd3956826c2bbd575",
     "outputs": {
      "format": "menu-files",
      "paths": [
       "data/menus",
       "data/products"
      ],
      "requiredFrom": "menu-extraction.basisRequiredFrom"
     },
     "pins": "data/menus"
    },
    {
     "role": "enforces",
     "kind": "code",
     "path": "scripts/check_data.py",
     "symbol": "check_menu_extraction",
     "calledBy": "scripts/check_data.py",
     "onReject": "halt",
     "tests": "tests/test_check_data.py"
    }
   ],
   "bindings": [
    {
     "path": "spine/bindings.json",
     "key": "menu-extraction"
    }
   ],
   "gap": {
    "text": "Menu files dated before the basis cutoff were extracted in agent sessions that recorded no model or prompt, and no gate re-reads a source to confirm an item's words and price.",
    "reviewBy": "2026-12-31"
   },
   "cases": [
    {
     "given": "a file with every row well formed and its extraction basis",
     "call": "scripts/check_data.py:menu_file_case",
     "input": "spine/cases/menu-extraction/with-basis.json",
     "expect": {
      "problems": 0
     }
    },
    {
     "given": "a file dated after the cutoff with no extraction basis",
     "call": "scripts/check_data.py:menu_file_case",
     "input": "spine/cases/menu-extraction/no-basis-after-cutoff.json",
     "expect": {
      "problems": 1
     }
    },
    {
     "given": "a price written as text",
     "call": "scripts/check_data.py:menu_file_case",
     "input": "spine/cases/menu-extraction/price-as-text.json",
     "expect": {
      "problems": 1
     }
    }
   ]
  },
  {
   "id": "menu-freshness",
   "statement": "A menu older than the kept age is flagged, and once past due it stops the build until it is refreshed or an extension is ruled.",
   "grain": "menu",
   "tier": "T1",
   "implementers": [
    {
     "role": "decides",
     "kind": "code",
     "path": "scripts/freshness.py",
