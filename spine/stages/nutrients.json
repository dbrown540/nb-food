       "outputs": {
        "format": "pins",
        "path": "data/food_map_pins.jsonl"
       },
       "pins": "data/food_map_pins.jsonl",
       "gap": {
        "text": "No labelled sample has been measured against this battery; a spot check is not a measurement.",
        "reviewBy": "2026-12-31"
       }
      },
      {
       "tier": "T1",
       "kind": "code",
       "label": "readings disagree or name no record: unmapped",
       "path": "scripts/map_foods.py",
       "symbol": "route_mapping"
      }
     ]
    },
    {
     "role": "enforces",
     "kind": "code",
     "path": "scripts/map_foods.py",
     "symbol": "check_food_map",
     "calledBy": "scripts/check_data.py",
     "onReject": "halt",
     "tests": "tests/test_map_foods.py"
    }
   ],
   "bindings": [
    {
     "path": "spine/bindings.json",
     "key": "food-mapping"
    }
   ],
   "inputs": [
    {
     "principle": "menu-extraction",
     "field": "items",
     "grain": "menu"
    }
   ],
   "cases": [
    {
     "given": "a package label on file",
     "call": "scripts/map_foods.py:decide_case",
     "input": "spine/cases/food-mapping/label-on-file.json",
     "expect": {
      "kind": "label"
     }
    },
    {
     "given": "a single food with its own public record",
     "call": "scripts/map_foods.py:decide_case",
     "input": "spine/cases/food-mapping/same-single-food.json",
     "expect": {
      "kind": "usda-single-food",
      "fdcId": 2710824
     }
    },
    {
     "given": "a restaurant dish with a surveyed dish of the same name",
     "call": "scripts/map_foods.py:decide_case",
     "input": "spine/cases/food-mapping/same-dish.json",
     "expect": {
      "kind": "usda-mixed-dish-estimate",
      "fdcId": 2706401
     }
    },
    {
     "given": "a dish the public records do not have: stays unmapped",
