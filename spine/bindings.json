  {
   "id": "attribute-vocabulary",
   "path": "data/attributes.json",
   "decidedOn": "2026-09-23",
   "by": "owner",
   "basis": "the nine attribute ids named in the owner's brief of 2026-09-23; definitions drafted for the owner's review, tightened 2026-09-23 on the owner's ruling: absent only when certain, pine nuts count as nuts, the three high attributes answered from a food's nature",
   "reviewBy": "2027-03-23"
  },
  {
   "id": "attribute-agreement",
   "binding": "item-attributes",
   "decidedOn": "2026-09-23",
   "by": "owner",
   "basis": "present needs two of three readings quoting the item, absent needs all three: an absent answer claims more than the words usually show, so it takes full agreement",
   "reviewBy": "2027-03-23"
  },
  {
   "id": "menu-max-age",
   "binding": "menu-freshness",
   "decidedOn": "2026-09-23",
   "by": "owner",
   "basis": "restaurant menus and store prices change seasonally; half a year is the proposed kept age",
   "reviewBy": "2027-03-23"
  },
  {
   "id": "food-aliases",
   "binding": "food-mapping",
   "decidedOn": "2026-09-23",
   "by": "owner",
   "basis": "the most frequent menu words missing from the USDA descriptions on 2026-09-23 (penne, prawn, nigiri, donut...), each given the words USDA uses; an alias only adds candidates, the classifier still decides",
   "reviewBy": "2027-03-23"
  }
